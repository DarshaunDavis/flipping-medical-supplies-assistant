<resources>
    <!-- Dark theme using MaterialComponents -->
    <style name="Theme.FlippingMedicalSuppliesAssistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Swapped brand colors -->
        <item name="colorPrimary">#CCE8E5</item>
        <item name="colorOnPrimary">#002F31</item>
        <item name="colorPrimaryVariant">#004D51</item>

        <item name="colorSecondary">#FFDCE1</item>
        <item name="colorOnSecondary">#3B0018</item>
        <item name="colorSecondaryVariant">#A12448</item>

        <!-- Background & surfaces -->
        <item name="android:windowBackground">#072847</item>
        <item name="colorSurface">#112240</item>
        <item name="colorOnSurface">#E0E6F0</item>

        <!-- Error state -->
        <item name="colorError">#CF6679</item>
        <item name="colorOnError">#000000</item>
    </style>

    <!-- Dark splash -->
    <style name="Theme.FlippingSplash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">#072847</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lislal_logo</item>
        <item name="windowSplashScreenBackground">#072847</item>
        <item name="postSplashScreenTheme">@style/Theme.FlippingMedicalSuppliesAssistant</item>
    </style>
</resources>
