<resources>
    <!-- Light theme using MaterialComponents -->
    <style name="Theme.FlippingMedicalSuppliesAssistant" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Core brand colors -->
        <item name="colorPrimary">#006D77</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryVariant">#004D51</item>

        <item name="colorSecondary">#EF476F</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryVariant">#A12448</item>

        <!-- Background & surfaces -->
        <item name="android:windowBackground">#FEFEFE</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#222222</item>

        <!-- Error state -->
        <item name="colorError">#B00020</item>
        <item name="colorOnError">#FFFFFF</item>
    </style>

    <!-- Splash inherits the same base -->
    <style name="Theme.FlippingSplash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">#FEFEFE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lislal_logo</item>
        <item name="windowSplashScreenBackground">#FEFEFE</item>
        <item name="postSplashScreenTheme">@style/Theme.FlippingMedicalSuppliesAssistant</item>
    </style>
</resources>
